# PickSpot API configuration
# Create an API key in the PickSpot merchant portal. Server-side only.
PICKSPOT_API_KEY=pk_live_your_api_key_here
PICKSPOT_BASE_URL=https://dev.pickspot.world
# Signing secret PickSpot gives you when the webhook URL is saved (whsec_...)
PICKSPOT_WEBHOOK_SECRET=your_webhook_secret_here

# The shop's public address, used in order links sent to PickSpot and in social
# previews. On Vercel leave it unset: the project's production address is used.
SITE_URL=http://localhost:3000

# Supabase (order records). Server-side only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard -> Settings -> API Keys -> a secret key (sb_secret_...). It bypasses
# row-level security: keep it out of the browser and out of git.
SUPABASE_SECRET_KEY=your_secret_key_here
